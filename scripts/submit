#!/usr/bin/env python3
"""
Unified Submission Script.

Usage:
    ./submit <script_path> [overrides...] [--bg]

Examples:
    ./submit experiments/ppi/link_prediction.py                    # Run task
    ./submit experiments/ppi/link_prediction.py dataset=huri       # Override
    ./submit experiments/ppi/link_prediction.py --bg               # Background
    ./submit experiments/ppi/plot.py                               # Standalone script

Config loading:
    experiments/ppi/link_prediction.py  →  configs/ppi/link_prediction.yaml
"""

import sys
import subprocess
import shutil
from pathlib import Path
import os
import shlex


def get_project_root(anchor_file="pyproject.toml"):
    path = Path.cwd()
    while path != path.parent:
        if (path / anchor_file).exists():
            return path
        path = path.parent
    return Path.cwd()


def is_hydra_task(script_path: Path) -> bool:
    """Check if script is a Hydra task (has run(cfg) function)."""
    try:
        content = script_path.read_text()
        return "def run(cfg" in content
    except Exception:
        return False


def cleanup_empty_runs(base_output_dir):
    """Deletes folders that contain ONLY logs."""
    if not base_output_dir.exists():
        return

    deleted_count = 0
    for root, dirs, files in os.walk(base_output_dir, topdown=False):
        current_dir = Path(root)
        if current_dir == base_output_dir:
            continue
        if not current_dir.exists():
            continue

        has_artifacts = False
        for f in files:
            if f.endswith(".log") or f == ".hydra":
                continue
            has_artifacts = True
            break

        has_valid_subdirs = any(
            d.is_dir() and d.name != ".hydra" for d in current_dir.iterdir()
        )

        if not has_artifacts and not has_valid_subdirs:
            try:
                shutil.rmtree(current_dir)
                deleted_count += 1
            except OSError:
                pass

    if deleted_count > 0:
        print(f"🧹 Removed {deleted_count} empty/failed run folders.")


def main():
    if len(sys.argv) < 2:
        print("Usage: ./submit <script_path> [options...] [--bg]")
        sys.exit(1)

    script_arg = None
    run_args = []
    is_bg = False

    for arg in sys.argv[1:]:
        if arg == "--bg":
            is_bg = True
        elif script_arg is None and not arg.startswith("-"):
            script_arg = arg
        else:
            run_args.append(arg)

    if script_arg is None:
        print("Usage: ./submit <script_path> [options...] [--bg]")
        sys.exit(1)

    project_root = get_project_root()
    original_script = Path(script_arg).resolve()
    experiment_name = None
    task_name = None

    # Detect experiment structure:
    # - experiments/<task>.py → configs/<task>.yaml (flat)
    # - experiments/<exp>/<task>.py → configs/<exp>/<task>.yaml (nested)
    parts = original_script.parts
    if "experiments" in parts:
        try:
            exp_idx = parts.index("experiments")
            remaining = parts[exp_idx + 1:]
            if len(remaining) == 1 and remaining[0].endswith(".py"):
                # Flat: experiments/<task>.py
                experiment_name = original_script.stem
                task_name = original_script.stem
            elif len(remaining) >= 2:
                # Nested: experiments/<exp>/<task>.py
                experiment_name = remaining[0]
                if original_script.suffix == ".py" and original_script.parent.name == experiment_name:
                    task_name = original_script.stem
        except (ValueError, IndexError):
            pass

    # Check if it's a Hydra task (has run(cfg) function)
    use_hydra = experiment_name and task_name and is_hydra_task(original_script)

    # Build session name for background mode
    if experiment_name and task_name:
        session_name = f"{experiment_name}_{task_name}"
    else:
        session_name = original_script.stem

    # --- Background Mode ---
    if is_bg:
        submit_script = Path(__file__).resolve()
        safe_args = [str(submit_script), script_arg] + run_args
        cmd_str = " ".join(shlex.quote(a) for a in safe_args)

        print(f"🚀 Launching in background screen: {session_name}")
        print(f"   Command: {cmd_str}")
        subprocess.run([
            "screen", "-dmS", session_name, "bash", "-c",
            f"{cmd_str}; echo 'Done. Press Enter.'; read",
        ])
        print(f"✅ Started. Attach: screen -r {session_name}")
        sys.exit(0)

    # --- Foreground Mode ---
    if use_hydra:
        # Hydra task: resolve config path
        # Flat: configs/<task>.yaml | Nested: configs/experiment/<exp>/<task>.yaml
        if experiment_name == task_name:
            # Flat structure
            config_path = project_root / "configs"
            config_name = task_name
        else:
            # Nested structure
            config_path = project_root / "configs" / "experiment" / experiment_name
            config_name = task_name

        if not (config_path / f"{config_name}.yaml").exists():
            print(f"⚠️  Config not found: {config_path / f'{config_name}.yaml'}")
            sys.exit(1)

        # Determine module path from file structure
        if experiment_name == task_name:
            # Flat: experiments/<task>.py → experiments.<task>
            module_path = f"experiments.{experiment_name}"
        else:
            # Nested: experiments/<exp>/<task>.py → experiments.<exp>.<task>
            module_path = f"experiments.{experiment_name}.{task_name}"

        cmd = [
            "poetry", "run", "python",
            str(project_root / "scripts" / "run_task.py"),
            f"--config-path={config_path}",
            f"--config-name={config_name}",
            f"hydra.searchpath=[file://{project_root}/configs]",
            f"project_root={project_root}",
            f"+_module_path={module_path}",
        ]
        cmd.extend(run_args)

        print(f"🚀 Running {experiment_name}/{task_name}")
        print(f"   Config: {config_path / f'{config_name}.yaml'}")
        print(f"   {' '.join(cmd)}")

    else:
        # Standalone script: run directly
        cmd = ["poetry", "run", "python", str(original_script)]
        cmd.extend(run_args)

        print(f"🚀 Running standalone: {original_script.name}")
        print(f"   {' '.join(cmd)}")

    # Execute
    result = subprocess.run(cmd, cwd=project_root)

    # Cleanup empty run folders
    output_dir = project_root / "outputs"
    if output_dir.exists():
        cleanup_empty_runs(output_dir)


if __name__ == "__main__":
    main()
