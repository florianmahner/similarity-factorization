#!/usr/bin/env python3
"""
Unified Submission Script.

Usage:
    ./submit <script_path> [overrides...] [--bg]

Examples:
    # Experiments (Hydra-based)
    ./submit experiments/ppi/link_prediction.py                    # Run task
    ./submit experiments/ppi/link_prediction.py dataset=huri       # Override
    ./submit experiments/ppi/link_prediction.py --bg               # Background

    # Sandbox (standalone scripts)
    ./submit sandbox/nsd/consensus_test/run.py --bg                # Timestamped output
    ./submit sandbox/nsd/consensus_test/run.py name=v2 --bg        # With suffix

Config loading:
    experiments/ppi/link_prediction.py  →  configs/ppi/link_prediction.yaml
    sandbox/nsd/test/run.py             →  sandbox/nsd/test/outputs/<timestamp>/
"""

import json
import sys
import subprocess
import shutil
from datetime import datetime
from pathlib import Path
import os
import shlex


def get_project_root(anchor_file="pyproject.toml"):
    path = Path.cwd()
    while path != path.parent:
        if (path / anchor_file).exists():
            return path
        path = path.parent
    return Path.cwd()


def is_hydra_task(script_path: Path) -> bool:
    """Check if script is a Hydra task (has run(cfg) function)."""
    try:
        content = script_path.read_text()
        return "def run(cfg" in content
    except Exception:
        return False


def is_sandbox_script(script_path: Path) -> bool:
    """Check if script is in sandbox directory."""
    return "sandbox" in script_path.parts


def get_sandbox_output_dir(script_path: Path, name_suffix: str | None = None) -> Path:
    """Create timestamped output directory for sandbox script."""
    # Find sandbox base (parent of run.py, should contain outputs/)
    sandbox_base = script_path.parent
    outputs_dir = sandbox_base / "outputs"

    # Create flat timestamp folder
    timestamp = datetime.now().strftime("%y%m%d_%H%M%S")
    if name_suffix:
        folder_name = f"{timestamp}_{name_suffix}"
    else:
        folder_name = timestamp

    output_dir = outputs_dir / folder_name
    output_dir.mkdir(parents=True, exist_ok=True)

    # Update 'latest' symlink
    latest_link = outputs_dir / "latest"
    if latest_link.is_symlink():
        latest_link.unlink()
    elif latest_link.exists():
        latest_link.unlink()
    latest_link.symlink_to(folder_name)

    return output_dir


def init_sandbox_job_status(output_dir: Path, script: Path, args: list[str]) -> None:
    """Initialize job.json for sandbox script tracking.

    The log file is always .status/log relative to the output directory.
    """
    status_dir = output_dir / ".status"
    status_dir.mkdir(exist_ok=True)

    job_data = {
        "name": f"sandbox_{script.parent.name}",
        "script": str(script),
        "args": args,
        "started": datetime.now().isoformat(),
        "ended": None,
        "status": "running",
        "pid": os.getpid(),
        "output_dir": str(output_dir),
        "log_file": str(status_dir / "log"),
        "error": None,
        "signal": None,
    }

    (status_dir / "job.json").write_text(json.dumps(job_data, indent=2))


def update_sandbox_job_status(output_dir: Path, status: str, error: str | None = None) -> None:
    """Update job.json status after completion."""
    job_file = output_dir / ".status" / "job.json"
    if not job_file.exists():
        return

    try:
        data = json.loads(job_file.read_text())
        data["status"] = status
        data["ended"] = datetime.now().isoformat()
        if error:
            data["error"] = error
        job_file.write_text(json.dumps(data, indent=2))
    except Exception:
        pass


def has_job_tracking(directory: Path) -> bool:
    """Check if directory has job tracking (don't delete tracked jobs)."""
    return (directory / ".status" / "job.json").exists()


def cleanup_empty_runs(base_output_dir):
    """Deletes folders that contain ONLY logs. Skips tracked jobs (have .status/job.json)."""
    if not base_output_dir.exists():
        return

    deleted_count = 0
    for root, dirs, files in os.walk(base_output_dir, topdown=False):
        current_dir = Path(root)
        if current_dir == base_output_dir:
            continue
        if not current_dir.exists():
            continue

        # Skip hidden directories and their parents
        if current_dir.name.startswith("."):
            continue

        # Skip directories with job tracking (keep for history)
        if has_job_tracking(current_dir):
            continue

        has_artifacts = False
        for f in files:
            if f.endswith(".log"):
                continue
            has_artifacts = True
            break

        has_valid_subdirs = any(
            d.is_dir() and d.name not in (".hydra", ".status")
            for d in current_dir.iterdir()
        )

        if not has_artifacts and not has_valid_subdirs:
            try:
                shutil.rmtree(current_dir)
                deleted_count += 1
            except OSError:
                pass

    if deleted_count > 0:
        print(f"🧹 Removed {deleted_count} empty/failed run folders.")


def main():
    if len(sys.argv) < 2:
        print("Usage: ./submit <script_path> [options...] [--bg]")
        sys.exit(1)

    script_arg = None
    run_args = []
    is_bg = False
    name_suffix = None  # For sandbox: name=xxx

    for arg in sys.argv[1:]:
        if arg == "--bg":
            is_bg = True
        elif arg.startswith("name="):
            name_suffix = arg.split("=", 1)[1]
        elif script_arg is None and not arg.startswith("-"):
            script_arg = arg
        else:
            run_args.append(arg)

    if script_arg is None:
        print("Usage: ./submit <script_path> [options...] [--bg]")
        sys.exit(1)

    project_root = get_project_root()
    original_script = Path(script_arg).resolve()
    experiment_name = None
    task_name = None
    is_sandbox = is_sandbox_script(original_script)

    # Detect experiment structure:
    # - experiments/<task>.py → configs/<task>.yaml (flat)
    # - experiments/<exp>/<task>.py → configs/<exp>/<task>.yaml (nested)
    parts = original_script.parts
    if "experiments" in parts:
        try:
            exp_idx = parts.index("experiments")
            remaining = parts[exp_idx + 1:]
            if len(remaining) == 1 and remaining[0].endswith(".py"):
                # Flat: experiments/<task>.py
                experiment_name = original_script.stem
                task_name = original_script.stem
            elif len(remaining) >= 2:
                # Nested: experiments/<exp>/<task>.py
                experiment_name = remaining[0]
                if original_script.suffix == ".py" and original_script.parent.name == experiment_name:
                    task_name = original_script.stem
        except (ValueError, IndexError):
            pass

    # Check if it's a Hydra task (has run(cfg) function)
    use_hydra = experiment_name and task_name and is_hydra_task(original_script)

    # Build session name for background mode
    if is_sandbox:
        # sandbox/group/name/run.py -> sandbox_group_name
        sandbox_idx = parts.index("sandbox")
        sandbox_parts = parts[sandbox_idx + 1:-1]  # Exclude "sandbox" and "run.py"
        session_name = "sandbox_" + "_".join(sandbox_parts)
    elif experiment_name and task_name:
        session_name = f"{experiment_name}_{task_name}"
    else:
        session_name = original_script.stem

    # --- Background Mode ---
    if is_bg:
        submit_script = Path(__file__).resolve()
        safe_args = [str(submit_script), script_arg] + run_args
        if name_suffix:
            safe_args.append(f"name={name_suffix}")
        cmd_str = " ".join(shlex.quote(a) for a in safe_args)

        print(f"🚀 Launching in background: {session_name}")
        print(f"   Command: {cmd_str}")

        # Start background process with stdout/stderr to /dev/null
        # The real log is captured in .status/log by run_task.py
        with open(os.devnull, "w") as devnull:
            proc = subprocess.Popen(
                ["bash", "-c", cmd_str],
                stdout=devnull, stderr=subprocess.STDOUT,
                start_new_session=True,
            )

        print(f"✅ Started (PID: {proc.pid})")
        print(f"   Status: ./scripts/jobs or dash")
        sys.exit(0)

    # --- Foreground Mode: Sandbox ---
    if is_sandbox:
        # Create timestamped output directory
        output_dir = get_sandbox_output_dir(original_script, name_suffix)

        # Set up environment
        env = os.environ.copy()
        env["SANDBOX_OUTPUT_DIR"] = str(output_dir)

        init_sandbox_job_status(output_dir, original_script, run_args)

        # Log file in .status/log
        log_file = output_dir / ".status" / "log"

        cmd = ["poetry", "run", "python", str(original_script)] + run_args

        print(f"🧪 Running sandbox: {original_script.parent.name}")
        print(f"   Output: {output_dir}")

        try:
            # Capture stdout/stderr to .status/log while showing on terminal
            with open(log_file, "w") as lf:
                process = subprocess.Popen(
                    cmd, cwd=project_root, env=env,
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1
                )
                # Tee output to both terminal and log file
                for line in process.stdout:
                    print(line, end="")
                    lf.write(line)
                    lf.flush()
                process.wait()
                result_code = process.returncode

            if result_code == 0:
                update_sandbox_job_status(output_dir, "completed")
                print(f"✅ Completed. Output: {output_dir}")
            else:
                update_sandbox_job_status(output_dir, "failed", f"Exit code: {result_code}")
                print(f"❌ Failed with exit code {result_code}")
        except Exception as e:
            update_sandbox_job_status(output_dir, "failed", str(e))
            print(f"❌ Error: {e}")

        return

    # --- Foreground Mode: Hydra ---
    if use_hydra:
        # Hydra task: resolve config path
        # Flat: configs/<task>.yaml | Nested: configs/experiment/<exp>/<task>.yaml
        if experiment_name == task_name:
            # Flat structure
            config_path = project_root / "configs"
            config_name = task_name
        else:
            # Nested structure
            config_path = project_root / "configs" / "experiment" / experiment_name
            config_name = task_name

        if not (config_path / f"{config_name}.yaml").exists():
            print(f"⚠️  Config not found: {config_path / f'{config_name}.yaml'}")
            sys.exit(1)

        # Determine module path from file structure
        if experiment_name == task_name:
            # Flat: experiments/<task>.py → experiments.<task>
            module_path = f"experiments.{experiment_name}"
        else:
            # Nested: experiments/<exp>/<task>.py → experiments.<exp>.<task>
            module_path = f"experiments.{experiment_name}.{task_name}"

        cmd = [
            "poetry", "run", "python",
            str(project_root / "scripts" / "run_task.py"),
            f"--config-path={config_path}",
            f"--config-name={config_name}",
            f"hydra.searchpath=[file://{project_root}/configs]",
            f"project_root={project_root}",
            f"+_module_path={module_path}",
        ]
        cmd.extend(run_args)

        print(f"🚀 Running {experiment_name}/{task_name}")
        print(f"   Config: {config_path / f'{config_name}.yaml'}")
        print(f"   {' '.join(cmd)}")

    else:
        # Standalone script: run directly
        cmd = ["poetry", "run", "python", str(original_script)]
        cmd.extend(run_args)

        print(f"🚀 Running standalone: {original_script.name}")
        print(f"   {' '.join(cmd)}")

    # Execute
    result = subprocess.run(cmd, cwd=project_root)

    # Cleanup empty run folders
    output_dir = project_root / "outputs"
    if output_dir.exists():
        cleanup_empty_runs(output_dir)


if __name__ == "__main__":
    main()
