#!/bin/bash
# Experiment runner wrapper
# Usage:
#   exp <experiment> <task> [args...]           - Single run
#   exp <experiment> <task> --sweep [args...]   - Parallel sweep (joblib)
#   exp <experiment> <task> --slurm [args...]   - SLURM sweep

set -e

if [ $# -lt 2 ]; then
    echo "Usage: exp <experiment> <task> [options] [hydra_args...]"
    echo ""
    echo "Options:"
    echo "  --sweep    Run parallel sweep with joblib"
    echo "  --slurm    Run sweep on SLURM cluster"
    echo "  --dry      Show config only (don't run)"
    echo ""
    echo "Examples:"
    echo "  exp bounds estimate estimate.dataset=mur92"
    echo "  exp embedding_generation generate generate.dataset=mur92"
    echo "  exp bounds estimate --sweep estimate.dataset=mur92,cichy118"
    echo "  exp bounds estimate --slurm estimate.dataset=mur92,cichy118"
    exit 1
fi

EXP=$1
TASK=$2
shift 2

# Parse options
MODE="single"
DRY=""
ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --sweep)
            MODE="sweep"
            shift
            ;;
        --slurm)
            MODE="slurm"
            shift
            ;;
        --dry)
            DRY="--cfg job"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# Build command
CMD="poetry run python scripts/run.py hydra/experiment@_global_=$EXP $TASK"

case $MODE in
    single)
        CMD="$CMD ${ARGS[*]} $DRY"
        ;;
    sweep)
        CMD="$CMD --multirun ${ARGS[*]} $DRY"
        ;;
    slurm)
        CMD="$CMD --multirun hydra/launcher=submitit_slurm ${ARGS[*]} $DRY"
        ;;
esac

echo "Running: $CMD"
eval $CMD
