#!/usr/bin/env python3
"""Experiment management for similarity-factorization.

Usage:
    ./run <experiment_name> [args...]     Run an experiment
    ./run list                             List all experiments
    ./run new <name>                       Create a new experiment
    ./run new scratch <description>        Create a scratch experiment
"""

import sys
import os
import subprocess
from pathlib import Path
from datetime import datetime


class Colors:
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    NC = '\033[0m'


def list_experiments():
    """List all available experiments."""
    print(f"{Colors.GREEN}Available experiments:{Colors.NC}\n")
    
    experiments_dir = Path("experiments")
    if not experiments_dir.exists():
        print("No experiments directory found")
        return
    
    # List regular experiments
    for exp_dir in sorted(experiments_dir.iterdir()):
        if not exp_dir.is_dir() or exp_dir.name.startswith("_"):
            continue
        
        exp_name = exp_dir.name
        run_file = exp_dir / "run.py"
        
        if run_file.exists():
            outputs_dir = exp_dir / "outputs"
            if outputs_dir.exists() and any(outputs_dir.iterdir()):
                # Get size
                result = subprocess.run(
                    ["du", "-sh", str(outputs_dir)],
                    capture_output=True,
                    text=True
                )
                size = result.stdout.split()[0] if result.returncode == 0 else "?"
                print(f"  {Colors.BLUE}{exp_name}{Colors.NC} {Colors.YELLOW}({size}){Colors.NC}")
            else:
                print(f"  {Colors.BLUE}{exp_name}{Colors.NC}")
    
    # List scratch experiments
    print(f"\n{Colors.GREEN}Scratch experiments:{Colors.NC}")
    scratch_dir = experiments_dir / "_scratch"
    if scratch_dir.exists() and any(scratch_dir.iterdir()):
        for exp_dir in sorted(scratch_dir.iterdir()):
            if exp_dir.is_dir():
                print(f"  {exp_dir.name}")
    else:
        print("  (none)")
    
    print(f"\nRun with: ./run <experiment_name>")


def create_experiment(args):
    """Create a new experiment."""
    if not args:
        print("Usage:")
        print('  ./run new <name>                Create a named experiment')
        print('  ./run new scratch <description> Create a scratch experiment')
        sys.exit(1)
    
    if args[0] == "scratch":
        # Create timestamped scratch experiment
        description = args[1] if len(args) > 1 else "experiment"
        date_str = datetime.now().strftime("%Y-%m-%d")
        exp_name = f"{date_str}_{description}"
        exp_dir = Path(f"experiments/_scratch/{exp_name}")
        
        exp_dir.mkdir(parents=True, exist_ok=False)
        (exp_dir / "outputs").mkdir(exist_ok=True)
        
        # Create run.py
        run_content = '''"""Quick scratch experiment."""

import numpy as np
from pathlib import Path

# Your experiment code here
if __name__ == "__main__":
    print("Running scratch experiment...")
    
    # Save outputs
    output_dir = Path("outputs")
    output_dir.mkdir(exist_ok=True)
    
    # Example: np.save(output_dir / "results.npy", data)
'''
        (exp_dir / "run.py").write_text(run_content)
        
        print(f"{Colors.GREEN}Created scratch experiment: {exp_name}{Colors.NC}")
        print(f"{Colors.YELLOW}Location: {exp_dir}{Colors.NC}\n")
        print(f"Run with: ./run _scratch/{exp_name}")
        
    else:
        # Create named experiment
        exp_name = args[0]
        exp_dir = Path(f"experiments/{exp_name}")
        
        if exp_dir.exists():
            print(f"{Colors.RED}Error: Experiment '{exp_name}' already exists{Colors.NC}")
            sys.exit(1)
        
        exp_dir.mkdir(parents=True)
        (exp_dir / "outputs").mkdir(exist_ok=True)
        
        # Create run.py
        run_content = f'''"""Experiment: {exp_name}

Description:
    TODO: Add description

Usage:
    ./run {exp_name} [args]
"""

import argparse
from pathlib import Path

def main(args):
    """Run experiment."""
    output_dir = Path("outputs")
    output_dir.mkdir(exist_ok=True)
    
    # Your experiment code here
    print(f"Running {exp_name} experiment...")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    # Add your arguments here
    # parser.add_argument("--param", type=int, default=10)
    
    args = parser.parse_args()
    main(args)
'''
        (exp_dir / "run.py").write_text(run_content)
        
        # Create README
        readme_content = f'''# {exp_name}

## Description

TODO: Describe what this experiment does

## Usage

```bash
./run {exp_name}
```

## Outputs

- `outputs/` - Results stored here
'''
        (exp_dir / "README.md").write_text(readme_content)
        
        print(f"{Colors.GREEN}Created experiment: {exp_name}{Colors.NC}")
        print(f"{Colors.YELLOW}Location: {exp_dir}{Colors.NC}\n")
        print(f"Run with: ./run {exp_name}")


def run_experiment(experiment_name, args):
    """Run an experiment."""
    exp_dir = Path(f"experiments/{experiment_name}")
    
    if not exp_dir.exists():
        print(f"{Colors.RED}Error: Experiment '{experiment_name}' not found{Colors.NC}\n")
        print("Available experiments:")
        list_experiments()
        sys.exit(1)
    
    run_file = exp_dir / "run.py"
    if not run_file.exists():
        print(f"{Colors.RED}Error: No run.py found in {exp_dir}{Colors.NC}")
        sys.exit(1)
    
    print(f"{Colors.GREEN}Running experiment: {experiment_name}{Colors.NC}")
    print(f"{Colors.YELLOW}Working directory: {exp_dir}{Colors.NC}\n")
    
    # Set PYTHONPATH to include repo root
    repo_root = Path.cwd()
    env = os.environ.copy()
    env["PYTHONPATH"] = f"{repo_root}:{env.get('PYTHONPATH', '')}"
    
    # Run the experiment
    result = subprocess.run(
        ["poetry", "run", "python", "run.py"] + args,
        cwd=exp_dir,
        env=env
    )
    
    sys.exit(result.returncode)


def main():
    """Main entry point."""
    if len(sys.argv) == 1:
        print(__doc__)
        sys.exit(1)
    
    command = sys.argv[1]
    
    if command == "list":
        list_experiments()
    elif command == "new":
        create_experiment(sys.argv[2:])
    elif command in ["-h", "--help", "help"]:
        print(__doc__)
    else:
        # Assume it's an experiment name
        run_experiment(command, sys.argv[2:])


if __name__ == "__main__":
    main()
