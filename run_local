#!/usr/bin/env python3
import argparse
import subprocess
from datetime import datetime
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument(
        "experiment", help="Path under experiments/ (e.g. development/imputation)"
    )
    parser.add_argument("--output-name", dest="output_name")
    parser.add_argument("--help", action="store_true")
    ns, remaining = parser.parse_known_args()
    if ns.help:
        parser.print_help()
        raise SystemExit
    if remaining and remaining[0] == "--":
        remaining = remaining[1:]
    ns.script_args = remaining
    return ns


def ensure_experiment(experiment: str) -> Path:
    repo_root = Path(__file__).resolve().parent
    exp_path = repo_root / "experiments" / experiment
    run_script = exp_path / "run.py"
    if not run_script.exists():
        raise SystemExit(f"run.py not found in experiments/{experiment}")
    return exp_path


def next_run_directory(exp_path: Path, output_name: str | None) -> Path:
    if output_name:
        run_dir = exp_path / output_name
        (run_dir / "outputs").mkdir(parents=True, exist_ok=True)
        (run_dir / "logs").mkdir(exist_ok=True)
        return run_dir
    day_prefix = datetime.now().strftime("%y%m%d")
    counter = 1
    while True:
        candidate = exp_path / f"{day_prefix}-{counter:02d}"
        if not candidate.exists():
            break
        counter += 1
    (candidate / "outputs").mkdir(parents=True, exist_ok=True)
    (candidate / "logs").mkdir(exist_ok=True)
    return candidate


def main() -> None:
    args = parse_args()
    exp_path = ensure_experiment(args.experiment)
    run_dir = next_run_directory(exp_path, args.output_name)
    repo_root = Path(__file__).resolve().parent
    run_script = exp_path / "run.py"
    cmd = [
        "poetry",
        "run",
        "python",
        str(run_script.relative_to(repo_root)),
        "--output-dir",
        str((run_dir / "outputs").relative_to(repo_root)),
    ]
    cmd.extend(args.script_args)
    subprocess.run(cmd, check=True, cwd=repo_root)


if __name__ == "__main__":
    main()
